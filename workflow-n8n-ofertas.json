    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst r = body.reserva;\nconst celebLine = r.celebracion && r.celebracion !== 'Ninguna' ? `<p style=\"margin:0;color:#333;font-size:1.1rem;\">🎉 <strong>${r.celebracion}</strong></p>` : '';\n\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.1);\">\n  <div style=\"background:linear-gradient(135deg,#8B0000,#C0392B);padding:24px;text-align:center;\">\n    <h1 style=\"color:#fff;margin:0;font-size:1.5rem;\">🔥 Parrillero Argentino</h1>\n  </div>\n  <div style=\"padding:24px;text-align:center;\">\n    <h2 style=\"color:#333;margin:0 0 8px 0;\">✅ Reserva Confirmada</h2>\n    <p style=\"color:#666;margin:0 0 24px 0;\">Hola <strong>${r.nombre}</strong>, tu reserva ha sido registrada exitosamente.</p>\n    <div style=\"background:#f8f9fa;padding:20px;border-radius:12px;margin-bottom:24px;text-align:left;\">\n      <p style=\"margin:0 0 12px 0;color:#333;font-size:1.1rem;\">📅 <strong>${r.fecha}</strong></p>\n      <p style=\"margin:0 0 12px 0;color:#333;font-size:1.1rem;\">🕐 <strong>${r.hora}</strong></p>\n      <p style=\"margin:0 0 12px 0;color:#333;font-size:1.1rem;\">👥 <strong>${r.personas} persona(s)</strong></p>\n      <p style=\"margin:0 0 12px 0;color:#333;font-size:1.1rem;\">📍 <strong>${r.ubicacion}</strong></p>\n      ${celebLine}\n    </div>\n    <div style=\"background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:12px;margin-bottom:20px;\">\n      <p style=\"margin:0;color:#856404;font-size:0.9rem;\">⏰ Te pedimos llegar <strong>15 minutos antes</strong> de la hora reservada.</p>\n    </div>\n    <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n    <p style=\"color:#333;font-size:0.9rem;\">📍 Carrera 38 # 10-47, El Poblado, Medellín</p>\n    <p style=\"color:#999;font-size:0.85rem;margin-top:8px;\">📞 +57 300 555 0147</p>\n    <p style=\"color:#333;font-size:0.9rem;margin-top:16px;\">¡Te esperamos! 🥩🔥</p>\n  </div>\n</div>`;\n\nreturn [{ json: { toEmail: r.email, subject: 'Confirmación de reserva - Parrillero Argentino', html } }];"
      },
