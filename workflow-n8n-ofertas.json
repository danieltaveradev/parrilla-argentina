      "id": "if-factura",
      "name": "¿Es Factura?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\nconst f = body.factura;\nconst items = f.items.map(i => `<tr style=\"border-bottom:1px solid #eee;\"><td style=\"padding:10px;\">${i.cantidad}</td><td style=\"padding:10px;\">${i.producto}</td><td style=\"padding:10px;text-align:right;\">$${i.precio.toLocaleString()}</td><td style=\"padding:10px;text-align:right;\">$${i.subtotal.toLocaleString()}</td></tr>`).join('');\n\nconst html = `<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.1);\">\n  <div style=\"background:linear-gradient(135deg,#8B0000,#C0392B);padding:24px;text-align:center;\">\n    <h1 style=\"color:#fff;margin:0;font-size:1.5rem;\">🔥 Parrillero Argentino</h1>\n    <p style=\"color:rgba(255,255,255,0.8);margin:4px 0 0 0;font-size:0.9rem;\">Carrera 38 # 10-47, El Poblado, Medellín</p>\n  </div>\n  <div style=\"padding:24px;\">\n    <h2 style=\"color:#333;margin:0 0 4px 0;text-align:center;\">FACTURA DE VENTA</h2>\n    <p style=\"color:#999;text-align:center;margin:0 0 20px 0;\">No. ${f.numero} | ${f.fecha}</p>\n    <div style=\"background:#f8f9fa;padding:16px;border-radius:8px;margin-bottom:20px;\">\n      <p style=\"margin:0 0 4px 0;color:#333;\"><strong>Cliente:</strong> ${f.cliente.nombre}</p>\n      <p style=\"margin:0 0 4px 0;color:#333;\"><strong>Cédula:</strong> ${f.cliente.cedula}</p>\n      <p style=\"margin:0;color:#333;\"><strong>Dirección:</strong> ${f.cliente.direccion}</p>\n    </div>\n    <table style=\"width:100%;border-collapse:collapse;margin-bottom:20px;\">\n      <thead><tr style=\"background:#8B0000;color:#fff;\"><th style=\"padding:10px;text-align:left;\">Cant.</th><th style=\"padding:10px;text-align:left;\">Producto</th><th style=\"padding:10px;text-align:right;\">Precio</th><th style=\"padding:10px;text-align:right;\">Subtotal</th></tr></thead>\n      <tbody>${items}</tbody>\n    </table>\n    <div style=\"text-align:right;margin-bottom:20px;\">\n      <p style=\"margin:0 0 4px 0;color:#666;\">Subtotal: ${f.subtotal}</p>\n      <p style=\"margin:0 0 4px 0;color:#666;\">IVA (19%): ${f.iva}</p>\n      <p style=\"margin:0;font-size:1.3rem;color:#8B0000;font-weight:bold;\">TOTAL: ${f.total}</p>\n    </div>\n    <div style=\"background:#f8f9fa;padding:12px;border-radius:8px;text-align:center;margin-bottom:20px;\">\n      <p style=\"margin:0;color:#333;\"><strong>Método de pago:</strong> ${f.pago}</p>\n    </div>\n    <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n    <p style=\"color:#333;font-size:0.9rem;text-align:center;\">¡Gracias por tu compra! Te esperamos pronto. 🥩🔥</p>\n  </div>\n</div>`;\n\nreturn [{ json: { toEmail: f.cliente.email, subject: `Factura #${f.numero} - Parrillero Argentino`, html } }];"
      },
