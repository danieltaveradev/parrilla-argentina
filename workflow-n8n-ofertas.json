    {
      "parameters": {
        "fromEmail": "parrillero.argentino@gmail.com",
        "toEmail": "={{ $json.email }}",
        "subject": "🔥 ¡Oferta especial de Parrillero Argentino!",
        "emailType": "html",
        "html": "<div style=\"font-family:Arial,sans-serif;max-width:600px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,0.1);\">\n  <div style=\"background:linear-gradient(135deg,#8B0000,#C0392B);padding:24px;text-align:center;\">\n    <h1 style=\"color:#fff;margin:0;font-size:1.5rem;\">🔥 Parrillero Argentino</h1>\n  </div>\n  <div style=\"padding:24px;text-align:center;\">\n    <h2 style=\"color:#333;margin:0 0 8px 0;\">¡Oferta Especial!</h2>\n    <h3 style=\"color:#8B0000;margin:0 0 16px 0;\">{{ $json.body.oferta.titulo }}</h3>\n    <p style=\"color:#666;font-size:1rem;margin:0 0 20px 0;\">{{ $json.body.oferta.descripcion }}</p>\n    <div style=\"background:#ff4500;color:#fff;padding:14px 32px;border-radius:30px;display:inline-block;font-weight:bold;font-size:1.3rem;margin:0 0 20px 0;\">\n      {{ $json.body.oferta.descuento }} DE DESCUENTO\n    </div>\n    <p style=\"color:#999;font-size:0.85rem;margin:0 0 8px 0;\">Válido hasta: <strong>{{ $json.body.oferta.vencimiento }}</strong></p>\n    <hr style=\"border:none;border-top:1px solid #eee;margin:20px 0;\">\n    <p style=\"color:#333;font-size:0.9rem;\">Te esperamos en<br><strong>Carrera 38 # 10-47, El Poblado, Medellín</strong> 🔥</p>\n    <p style=\"color:#999;font-size:0.75rem;margin-top:16px;\">Si no deseas recibir estos correos, responde con STOP.</p>\n  </div>\n</div>",
        "options": {}
      },
      "id": "send-email-oferta",
